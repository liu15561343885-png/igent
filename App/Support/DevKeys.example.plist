<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  把本文件复制为 DevKeys.plist（同目录），填入真实 Key。
  DevKeys.plist 已在 .gitignore 里，不会被提交。

  只在 DEBUG 构建、且启动参数带 -devKeys 时生效；
  值会写进钥匙串并设定当前厂商，Release 构建完全不读这个文件。
-->
<plist version="1.0">
<dict>
    <!-- 对话厂商 -->
    <key>chatFamily</key>
    <string>openai-compatible</string>   <!-- openai-compatible / openai-responses / anthropic / gemini -->
    <key>chatBaseURL</key>
    <string>https://api.openai.com/v1</string>
    <key>chatModel</key>
    <string>gpt-4o-mini</string>
    <key>chatKey</key>
    <string></string>

    <!-- DeepSeek：联网检索 + 文件解析共用 -->
    <key>deepseekKey</key>
    <string></string>

    <!-- 生图（可与对话同一个 OpenAI Key） -->
    <key>imageBaseURL</key>
    <string>https://api.openai.com/v1</string>
    <key>imageModel</key>
    <string>gpt-image-1</string>
    <key>imageKey</key>
    <string></string>
</dict>
</plist>
